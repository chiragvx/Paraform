{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ParaForm",
  "version": "0.1.0",
  "identifier": "com.paraform.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run sidecar:ensure && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ParaForm",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/b123d_server"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
