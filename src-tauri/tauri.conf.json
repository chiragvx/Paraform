{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ParaForm",
  "version": "0.1.0",
  "identifier": "com.paraform.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run sidecar:ensure && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ParaForm",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "ParaForm",
    "copyright": "© 2026 ParaForm",
    "shortDescription": "AI-native parametric CAD for functional machines",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/b123d_server"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["paraform"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/chiragvx/Paraform/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2RUM4RjBBRkRBODBGNjAKUldSZ0Q2ajlDby9zTnNaRDhoR21oTTB1VFNjZmh1YmQyV3k1ZnZ1NEJrV1NyT25hZVdTckRaT1MK"
    }
  }
}
