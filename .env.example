# Para-form environment template — copy to .env and fill in real values.
# .env is gitignored; never commit real keys. Both the Vite dev server and
# the Python kernel (b123d_server/server.py loads ../.env via python-dotenv)
# read this file.

# ── Supabase project (shared by browser client + kernel) ────────────────────
# Project URL + publishable (anon) key — safe to expose to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Kernel base URL the studio talks to (default: local kernel).
VITE_ENGINE_URL=http://localhost:7823

# Hosted MCP gateway URL the studio's "Connect Claude" button pairs with.
# Set this to your deployed mcp/remote_server.mjs URL (HTTPS in production —
# claude.ai connectors require HTTPS). Defaults to http://localhost:8080 on
# localhost so dev works out of the box.
VITE_MCP_REMOTE_URL=http://localhost:8080

# Studio sign-in gate. Login is now MANDATORY whenever Supabase is configured
# (VITE_SUPABASE_URL + key set) — the studio gate auto-requires sign-in in any
# real deployment. Set VITE_REQUIRE_AUTH=0 to force-disable (explicit escape
# hatch). Unconfigured dev/tests stay open automatically.
VITE_REQUIRE_AUTH=0

# ── AI proxy keys (server-held fallback) ─────────────────────────────────────
# These are the FALLBACK keys. Users can also paste their own key (and a host
# base URL) in the studio under Settings → AI Assistant — those are stored in
# the browser and sent to this proxy per-request, overriding the keys below.
# Default provider is OpenAI-compatible — **OpenRouter is recommended** because
# one key gives you GPT-OSS, Claude, Gemini and more. Get a key at
# https://openrouter.ai/keys and paste into the studio's Settings → AI panel
# (session-only). Other hosts:
#   OpenRouter: https://openrouter.ai/api/v1        (model: openai/gpt-oss-120b)  ← default base
#   Groq:       https://api.groq.com/openai/v1      (model: openai/gpt-oss-120b)
#   Together:   https://api.together.xyz/v1         (model: openai/gpt-oss-120b)
#   Ollama:     http://localhost:11434/v1           (model: gpt-oss:120b, key: "ollama")
# OPENAI_BASE_URL defaults to OpenRouter when unset.
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional alternative providers (selectable in Settings → AI Assistant).
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Kernel auth gate (b123d_server/auth_gate.py) ─────────────────────────────
# "1"/"true" enables Supabase JWT verification + daily caps on POST /execute,
# POST /measure and POST /ai/chat. Default 0 = open (local dev).
REQUIRE_AUTH=0

# Service-role (secret) key — server-side ONLY. Enables plan lookup
# (profiles.plan) and durable usage counting via the increment_usage RPC.
# Without it the kernel treats every user as plan 'free' and falls back to
# per-process in-memory counters.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ── Daily caps (per user, per UTC day; integers) ─────────────────────────────
# Free plan:
CAP_AI_PER_DAY=15            # /ai/chat calls per day
CAP_EXECUTE_PER_DAY=60       # /execute + /measure calls per day
# Pro plan ($9.99/mo, plan='paid'):
CAP_AI_PER_DAY_PRO=200
CAP_EXECUTE_PER_DAY_PRO=1000

# ── Billing (Stripe) — b123d_server/billing.py ──────────────────────────────
# Only needed to enable the Pro ($9.99/mo) plan. Leave unset to run free-only.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx        # from the Stripe webhook endpoint config
STRIPE_PRICE_ID=price_xxx             # the recurring $9.99/mo price
APP_URL=http://localhost:1420         # base URL for checkout success/cancel redirects
