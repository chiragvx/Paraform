{
  "name": "3d_play",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/ensure-sidecar.js && tauri dev",
    "tauri:build": "node scripts/ensure-sidecar.js && tauri build",
    "sidecar:build": "python b123d_server/build_sidecar.py",
    "sidecar:ensure": "node scripts/ensure-sidecar.js",
    "kernel": "python b123d_server/server.py",
    "kernel:dev": "cross-env VITE_ENGINE_URL=http://localhost:7823 vite",
    "start": "concurrently -n kernel,vite -c blue,green \"npm:kernel\" \"npm:kernel:dev\"",
    "test": "node lib/document/__tests__/all.mjs",
    "test:smoke": "node tests/smoke/runner.mjs",
    "test:stability": "node tests/eval/stability/runner.mjs",
    "test:eval-harness": "node src/lib/ai/eval/__tests__/eval.test.mjs",
    "test:assembly-constraints": "node src/lib/library/__tests__/assembly_constraints.test.mjs",
    "eval": "node --import ./src/lib/commands/__tests__/_register.mjs tests/eval/runner.mjs",
    "eval:update-baseline": "node --import ./src/lib/commands/__tests__/_register.mjs tests/eval/runner.mjs --update-baseline",
    "validate": "node scripts/validate.mjs",
    "ui:validate": "node scripts/ui_validate.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "playwright": "^1.60.0",
    "svelte": "^5.56.2",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@lucide/svelte": "^1.17.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vercel/analytics": "^2.0.1",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "occt-import-js": "^0.0.23",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "three": "^0.184.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.10"
  }
}
